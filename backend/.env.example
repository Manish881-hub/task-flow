# Copy to .env and adjust. Never commit .env.
DATABASE_URL=sqlite:///./taskflow.db
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_MIN=15
REFRESH_DAYS=7
CORS_ORIGINS=http://localhost:3000
ENV=dev
RATE_LIMIT_ENABLED=true

# --- Production (Vercel backend service env) ---
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/taskflow
# JWT_SECRET=<openssl rand -hex 32>            # required, min 32 chars
# CORS_ORIGINS=https://<your-vercel-domain>   # same-domain deploy: your public URL
# ENV=prod                                     # prod => Secure refresh cookies (HTTPS)
# Run migrations before serving: alembic upgrade head
# (lifespan create_all remains as a safety net, not the strategy)
