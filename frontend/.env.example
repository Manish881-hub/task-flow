NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- Production (Vercel frontend service env, same-domain deploy) ---
# NEXT_PUBLIC_* are BUILD-TIME values: set them before the Vercel build.
# Same-domain (recommended): point both at the public domain so API + WS ride
# it (same-site cookies, no CORS pain). Omit them entirely and the app uses
# window.location.origin automatically on any non-localhost host.
# NEXT_PUBLIC_API_URL=https://<your-vercel-domain>
# NEXT_PUBLIC_WS_URL=wss://<your-vercel-domain>
